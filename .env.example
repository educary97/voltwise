# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional ──────────────────────────────────────────────────────────────────
# Database (for storing comparison history)
DATABASE_URL=postgresql://user:password@host:5432/voltwise

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# GDPR: invoice storage (if enabling save history)
# Set to 'none' to never persist uploaded invoices
INVOICE_STORAGE=none
