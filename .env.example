# ─── Voltwise Agent — Environment Variables ───────────────────────────────────
# Copy these into your Vercel project settings and your local .env.local
# NEVER commit this file with real values

# ── Your current electricity plan ─────────────────────────────────────────────
CURRENT_SUPPLIER="EDP Comercial"
CURRENT_PLAN="Simples"
CURRENT_MONTHLY_KWH=300
CURRENT_MONTHLY_COST=65.00
SWITCHING_THRESHOLD_EUR=5

# ── Your personal details (used to pre-fill the supplier email) ────────────────
USER_NAME="O Teu Nome"
USER_NIF="123456789"
USER_IBAN="PT50 0000 0000 0000 0000 0000 0"
USER_CPE="PT0000000000000000XX"
USER_EMAIL="o.teu@email.com"
USER_ADDRESS="Rua Exemplo, 123, 1000-001 Lisboa"
USER_PHONE="+351 912 345 678"

# ── Twilio WhatsApp ────────────────────────────────────────────────────────────
# Get these from console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
# Twilio sandbox number (or your approved sender):
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Your WhatsApp number to receive alerts:
NOTIFY_WHATSAPP_TO="whatsapp:+351912345678"

# ── Resend (for sending the supplier email once approved) ──────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NOTIFY_TO_EMAIL="o.teu@email.com"

# ── Security ───────────────────────────────────────────────────────────────────
# Random string — generate with: openssl rand -base64 32
AGENT_APPROVE_SECRET="replace-with-a-long-random-secret"

# Used internally to build approval URLs
NEXT_PUBLIC_APP_URL="https://your-voltwise-app.vercel.app"

# ── Vercel Cron protection ─────────────────────────────────────────────────────
# Vercel sets this automatically. For manual triggers, pass as Bearer token.
CRON_SECRET="vercel-sets-this-automatically"
